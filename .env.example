# Copy to .env and fill in. Real environment variables override this file.

# Get a key at https://the-odds-api.com. Without one the app runs on synthetic demo data.
ODDS_API_KEY=
# ODDS_PROVIDER=odds_api        # or "demo"

# Which books to pull. BOOKMAKERS overrides REGIONS; every 10 books cost 1 region-unit.
# Check https://the-odds-api.com/sports-odds-data/bookmaker-apis.html for current keys.
REGIONS=us,us2
# BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us,espnbet,betrivers,fanatics,hardrockbet,bovada,betonlineag,lowvig,pinnacle
MARKETS=h2h,spreads,totals

# Each poll costs (region-units x markets) credits: 2 x 3 = 6 with the defaults above.
POLL_SECONDS=60
MIN_CREDITS_RESERVE=50

# Books whose no-vig price is treated as fair when they quote the same line.
# Pinnacle is in the "eu" region; add it via BOOKMAKERS or REGIONS=us,us2,eu.
SHARP_BOOKS=pinnacle,circasports,lowvig

# Alert thresholds
EV_THRESHOLD=0.02
SPREAD_OFF_MARKET=1.0
TOTAL_OFF_MARKET=1.5
MIDDLE_MIN_WIDTH=1.0
STALE_SECONDS=300
MIN_CONSENSUS_BOOKS=2

# Log every line move to SQLite (for CLV / backtesting). Leave blank to disable.
HISTORY_DB=lines.sqlite3
# Where hand-entered promos are saved
PROMOS_FILE=promos.json
